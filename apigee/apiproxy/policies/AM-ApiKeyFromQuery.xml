<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-ApiKeyFromQuery">
  <DisplayName>API key from ?apikey= for callers that cannot set headers</DisplayName>
  <!-- Application Integration's REST task (and some webhooks) can only set the URL; VerifyAPIKey reads the header -->
  <Set>
    <Headers>
      <Header name="x-api-key">{request.queryparam.apikey}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>

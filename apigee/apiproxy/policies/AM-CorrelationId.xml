<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-CorrelationId">
  <DisplayName>Propagate / mint X-Correlation-Id</DisplayName>
  <!-- Keep the caller's id if present, otherwise use Apigee's message id so logs line up end to end -->
  <AssignVariable>
    <Name>correlation_id</Name>
    <Ref>request.header.x-correlation-id</Ref>
    <Value>{messageid}</Value>
  </AssignVariable>
  <Set>
    <Headers>
      <Header name="X-Correlation-Id">{correlation_id}</Header>
      <Header name="X-Apigee-Client-Id">{client_id}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>

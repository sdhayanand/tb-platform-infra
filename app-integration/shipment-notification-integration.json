{
  "name": "projects/PROJECT_ID/locations/us-central1/integrations/tb-shipment-exception-to-ops",
  "description": "GCP Application Integration: when a ShipmentEvent with status EXCEPTION arrives on shipments-v1, enrich it with the order from the Order API and open a ticket by POSTing to the ops webhook. Low-code equivalent of a TIBCO BusinessWorks process.",
  "triggerConfigs": [
    {
      "label": "Pub/Sub trigger: shipments-v1",
      "triggerType": "CLOUD_PUBSUB_EXTERNAL",
      "triggerNumber": "1",
      "triggerId": "cloud_pubsub_external_trigger/projects/PROJECT_ID/subscriptions/shipments-app-integration",
      "properties": {
        "Subscription name": "projects/PROJECT_ID/subscriptions/shipments-app-integration",
        "Service account": "tb-app-integration@PROJECT_ID.iam.gserviceaccount.com"
      },
      "startTasks": [ { "taskId": "1" } ]
    }
  ],
  "taskConfigs": [
    {
      "task": "FieldMappingTask",
      "taskId": "1",
      "displayName": "Parse ShipmentEvent",
      "parameters": {
        "FieldMappingConfig": {
          "key": "FieldMappingConfig",
          "value": {
            "jsonValue": "{\"@type\":\"type.googleapis.com/enterprise.crm.eventbus.proto.FieldMappingConfig\",\"mappedFields\":[{\"inputField\":{\"fieldType\":\"JSON_VALUE\",\"transformExpression\":{\"initialValue\":{\"referenceValue\":\"$CloudPubSubMessage.data$\"},\"transformationFunctions\":[{\"functionType\":{\"stringFunction\":{\"functionName\":\"TO_JSON\"}}}]}},\"outputField\":{\"referenceKey\":\"$shipmentEvent$\",\"fieldType\":\"JSON_VALUE\",\"cardinality\":\"OPTIONAL\"}},{\"inputField\":{\"fieldType\":\"STRING_VALUE\",\"transformExpression\":{\"initialValue\":{\"referenceValue\":\"$shipmentEvent.status$\"}}},\"outputField\":{\"referenceKey\":\"$status$\",\"fieldType\":\"STRING_VALUE\",\"cardinality\":\"OPTIONAL\"}},{\"inputField\":{\"fieldType\":\"STRING_VALUE\",\"transformExpression\":{\"initialValue\":{\"referenceValue\":\"$shipmentEvent.orderId$\"}}},\"outputField\":{\"referenceKey\":\"$orderId$\",\"fieldType\":\"STRING_VALUE\",\"cardinality\":\"OPTIONAL\"}}]}"
          }
        }
      },
      "nextTasks": [
        { "taskId": "2", "condition": "$status$ = \"EXCEPTION\"", "displayName": "exception only" }
      ]
    },
    {
      "task": "GenericRestV2Task",
      "taskId": "2",
      "displayName": "GET order from Order API (Apigee)",
      "parameters": {
        "url": { "key": "url", "value": { "stringValue": "https://api.tb-otd.example/v1/orders/$orderId$" } },
        "httpMethod": { "key": "httpMethod", "value": { "stringValue": "GET" } },
        "urlFetchingService": { "key": "urlFetchingService", "value": { "stringValue": "HARPOON" } },
        "requestorId": { "key": "requestorId", "value": { "stringValue": "tb-app-integration" } },
        "additionalHeaders": { "key": "additionalHeaders", "value": { "stringArray": { "stringValues": ["x-api-key: $apiKey$", "X-Correlation-Id: $shipmentEvent.correlationId$"] } } },
        "responseBody": { "key": "responseBody", "value": { "stringValue": "$orderResponse$" } }
      },
      "nextTasks": [ { "taskId": "3" } ]
    },
    {
      "task": "GenericRestV2Task",
      "taskId": "3",
      "displayName": "Open ops ticket (webhook)",
      "parameters": {
        "url": { "key": "url", "value": { "stringValue": "$opsWebhookUrl$" } },
        "httpMethod": { "key": "httpMethod", "value": { "stringValue": "POST" } },
        "requestBody": { "key": "requestBody", "value": { "stringValue": "{\"title\":\"Shipment exception for $orderId$\",\"carrier\":\"$shipmentEvent.carrier$\",\"tracking\":\"$shipmentEvent.trackingNumber$\",\"location\":\"$shipmentEvent.location$\",\"order\":$orderResponse$}" } },
        "additionalHeaders": { "key": "additionalHeaders", "value": { "stringArray": { "stringValues": ["content-type: application/json"] } } }
      }
    }
  ],
  "integrationParameters": [
    { "key": "shipmentEvent", "dataType": "JSON_VALUE", "displayName": "shipmentEvent" },
    { "key": "status", "dataType": "STRING_VALUE", "displayName": "status" },
    { "key": "orderId", "dataType": "STRING_VALUE", "displayName": "orderId" },
    { "key": "orderResponse", "dataType": "STRING_VALUE", "displayName": "orderResponse" },
    { "key": "apiKey", "dataType": "STRING_VALUE", "displayName": "apiKey", "inputOutputType": "IN", "masked": true },
    { "key": "opsWebhookUrl", "dataType": "STRING_VALUE", "displayName": "opsWebhookUrl", "inputOutputType": "IN", "defaultValue": { "stringValue": "https://ops-tickets.example/webhook" } }
  ]
}
